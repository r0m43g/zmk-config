#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include "behaviors.dtsi"

/ {
        keymap {
                compatible = "zmk,keymap";

                rat_layer {
                        label = "RATISE";
                        // 0: RATISE layer -----------------------------------------------------------------
                        // |  Q  |  Ū  |  Ė  |  Y  |  O  |  F  |-------|  J  |  N  |  K  |  G  |  B  |  C  |
                        // |  W  |  U  |  E  |  I  |  A  |  H  |-------|  L  |  R  |  T  |  S  |  P  |  Z  |
                        // |  -  |  Ų  |  Ę  |  Į  |  Ą  |  X  |-------|  V  |  M  |  D  |  Š  |  Č  |  Ž  |
                        //                   | ESC | NAV | SPC |-------| SPC | SYM  | RET |
                        bindings = <
   &kp W    &kp N8      &kp N4        &kp Y       &kp O         &kp Q         &kp J &kp N       &kp K       &kp G         &kp B       &kp C
   &kp F    &kp U       &kp E         &kp I       &kp A         &kp H         &kp L &kp R       &kp T       &kp S         &kp P       &kp EQUAL
   &kp BSPC &kp N7      &hm LCTRL N3  &hm LALT N5 &hm LSHFT N1  &kp X         &kp V &hm LSHFT M &hm RALT D  &hm LCTRL N6  &kp N2      &kp Z
                                     &hm LGUI ESC   &lt 6 SPACE   &mo 1     &mo 1 &lt 7 SPACE   &hm RGUI RET
                        >;
                };

                symlt_layer {
                        label = "SYMLT";
                        // 1: SYM layer ---------------------------------------------------------------------
                        // | TAB |  !  |  @  |  #  |  $  |  %  |-------|  ^  |  &  |  *  |  _  |  =  | BSPC |
                        // | @   |  `  |  ~  |  \  |  (  |  [  |-------|  ]  |  )  |  "  |  :  |  ;  | '    |
                        // | -   |  +  |  =  | '|' |  {  |  <  |-------|  >  |  }  |  ,  |  .  |  /  | ?    |
                        //                   |     |     |     |-------|     |caps_w|     |
                        bindings = <
   &kp TAB    &kp RA(EXCL) &kp RA(AT)    &kp RA(HASH) &kp RA(DLLR)  &kp RA(PRCNT)     &kp RA(CARET) &kp RA(AMPS)  &kp RA(ASTRK) &kp UNDER &kp RA(EQUAL) &kp MINUS
   &kp RA(AT) &kp GRAVE    &kp TILDE     &kp BSLH     &kp LPAR      &kp RPAR          &kp LBKT      &kp RBKT      &kp DQT       &kp COLON &kp SEMI      &kp SQT
   &kp DEL    &kp RA(PLUS) &kp RA(EQUAL) &kp PIPE     &kp LBRC      &kp RBRC          &kp LT        &kp GT        &kp COMMA     &kp DOT   &kp FSLH      &kp RS(FSLH)
                        &trans     &trans     &trans        &trans     &caps_word     &trans
                        >;
                };

                qwerty_layer {
                        label = "QWERTY";
                        // 2: ---------------------------------------------------------------------------------
                        // |  TAB |  Q  |  W  |  E  |  R  |  T  |-------|  Y  |  U   |  I  |  O  |  P  | BSPC |
                        // | @    |  A  |  S  |  D  |  F  |  G  |-------|  H  |  J   |  K  |  L  |  ;  |  '   |
                        // | -    |  Z  |  X  |  C  |  V  |  B  |-------|  N  |  M   |  ,  |  .  |  /  | !    |
                        //                    | ESC | NAV | SPC |-------| SPC | SYM  | RET |
                        bindings = <
   &kp TAB   &kp Q      &kp W       &kp E       &kp R       &kp T         &kp Y     &kp U       &kp I           &kp O         &kp P         &kp MINUS
   &kp AT    &kp A      &kp S       &kp D       &kp F       &kp G         &kp H     &kp J       &kp K           &kp L         &kp SEMI      &kp SQT
   &kp BSPC  &kp Z      &hm LCTRL X &hm LALT C  &hm LSHFT V &kp B         &kp N     &hm RSHFT M &hm RALT COMMA  &hm RCTRL DOT &hm FSLH      &kp QMARK
                                  &hm LGUI ESC   &lt 6 SPACE   &mo 3     &mo 3 &lt 7 SPACE   &hm RGUI RET
                        >;
                };

                sym_layer {
                        label = "SYM";
                        // 3: SYM layer ---------------------------------------------------------------------
                        // | TAB |  !  |  @  |  #  |  $  |  %  |-------|  ^  |  &  |  *  |  _  |  =  | BSPC |
                        // | @   |  `  |  ~  |  \  |  (  |  [  |-------|  ]  |  )  |  "  |  :  |  ;  | '    |
                        // | -   |  +  |  =  | '|' |  {  |  <  |-------|  >  |  }  |  ,  |  .  |  /  | ?    |
                        //                   |     |     |     |-------|     |caps_w|     |
                        bindings = <
   &kp TAB  &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT       &kp CARET  &kp AMPS   &kp ASTRK  &kp UNDER  &kp EQUAL  &kp MINUS
   &kp AT   &kp GRAVE  &kp TILDE  &kp BSLH   &kp LPAR   &kp RPAR        &kp LBKT   &kp RBKT   &kp DQT    &kp COLON  &kp SEMI   &kp SQT
   &kp DEL  &kp PLUS   &kp EQUAL  &kp PIPE   &kp LBRC   &kp RBRC        &kp LT     &kp GT     &kp COMMA  &kp DOT    &kp FSLH   &kp QMARK
                                  &trans     &trans     &trans          &trans     &caps_word &trans
                        >;
                };
                ru_layer {
                        label = "RU";
                        // 4: RU layer ----------------------------------------------------------------------
                        // |  Щ  |  Ю  |  Э  |  Ы  |  О  |  Щ  |-------|  Й  |  Н  |  К  |  Г  |  П  |  Ц  |
                        // |  Ф  |  У  |  Е  |  И  |  А  |  Х  |-------|  Л  |  Р  |  Т  |  С  |  П  |  Ж  |
                        // | BSPC|  Ю  |  Ё  |  Ь  |  Я  |  Ъ  |-------|  В  |  М  |  Д  |  Ш  |  Ч  |  З  |
                        //                   | ESC | NAV | SPC |-------| SPC | SYM | RET |
                        bindings = <
   &kp O    &kp DOT       &kp SQT         &kp S       &kp J       &kp O         &kp Q     &kp Y       &kp R       &kp U       &kp COMMA   &kp W
   &kp A    &kp E         &kp T           &kp B       &kp F       &kp LBKT      &kp K     &kp H       &kp N       &kp C       &kp G       &kp SEMI
   &kp BSPC &kp DOT       &hm LCTRL GRAVE &hm LALT M  &hm LSHFT Z &kp RBKT      &kp D     &hm RSHFT V &hm RALT L  &hm RCTRL I &kp X       &kp P
                                        &hm LGUI ESC   &lt 6 SPACE   &mo 5     &mo 5 &lt 7 SPACE   &hm RGUI RET
                        >;
                };

                symru_layer {
                        label = "SYMRU";
                        // 5: SYMRU layer ---------------------------------------------------------------------
                        // | TAB |  ю  |  ж  |  ё  |  ;  |  %  |------|  :  |  ?   |  *  |  (  |  )  |  щ  |
                        // |  :  |  ?  |  с  |  \  |  (  |  г  |------|  х  |  )   |  "  |  :  |  ;  |  "  |
                        // |BSPC |  ъ  |  ь  |  ц  |  в  |  б  |------|  н  |  м   |  ,  |  .  |  /  |  ?  |
                        //                   | ESC | NAV | SPC |------| SPC | SYM  | RET |
                        bindings = <
   &kp TAB &kp LS(N1) &kp LS(N2) &kp LS(N3) &kp LS(N4) &kp LS(N5)     &kp LS(N6) &kp LS(N7) &kp LS(N8)   &kp UNDER  &kp EQUAL    &kp MINUS
   &trans  &trans     &trans    &trans      &kp LS(N9) &kp LS(N0)     &kp LS(N9) &kp LS(N0) &kp LS(N2)   &kp LS(N6) &kp LS(N4)   &kp LS(N2)
   &kp DEL &kp RBKT   &kp M     &kp LS(N3)  &kp LS(N9) &kp LS(N0)     &kp LS(N9) &kp LS(N0) &kp LS(FSLH) &kp FSLH   &kp LS(BSLH) &kp LS(N7)
                                &trans      &trans     &trans         &trans     &caps_word &trans
                        >;
                };

                nav_layer {
                        label = "NAV";
                        // 6: NAV layer -------------------------------------------------------------
                        // | TAB |  EN |  EN |  RU | RAT | C_I |-------|  C_LFT |   PGDN | PGUP  | C_RGT |      | BSPC |
                        // |CAPS | C_A | WS_S| W_D | C_F | C_U |-------|   LFT  |   DWN  |  UP   |  RGT  | HOME | END  |
                        // | DEL | C_Z | C_X | C_C | C_V | C_B |-------| CS_LFT | S_HOME | S_END | CS_RGT| INS  | DEL  |
                        //                   |     |     |     |-------|        | caps_w |       |
                        bindings = <
   &kp TAB   &switch_en &switch_en    &switch_ru &switch_rat &kp LC(I)     &kp LC(LEFT)     &kp PG_DN    &kp PG_UP   &kp LC(RIGHT)     &trans   &kp BSPC
   &kp CAPS  &kp LC(A)  &kp LG(LS(S)) &kp LG(D)  &kp LC(F)   &kp LC(U)     &kp LEFT         &kp DOWN     &kp UP      &kp RIGHT         &kp HOME &kp END
   &kp DEL   &kp LC(Z)  &kp LC(X)     &kp LC(C)  &kp LC(V)   &kp LC(B)     &kp LC(LS(LEFT)) &kp LS(HOME) &kp LS(END) &kp LC(LS(RIGHT)) &kp INS  &kp DEL
                        &trans        &trans     &trans        &trans       &caps_word      &trans
                        >;
                };

                fn_layer {
                        label = "FN";
                        // 7: FN layer --------------------------------------------------------------------
                        // | F1  | F2  | F3  | F4  | F5  | F6  |---|  0  |  7  |  8  |  9  |  *  |  /   |
                        // | F7  | F8  | F9  | F10 | F11 | F12 |---|  0  |  4  |  5  |  6  |  -  |  =   |
                        // | DEL | BT1 | BT2 | BT3 | BT4 | BT5 |---|  0  |  1  |  2  |  3  |  +  |  .   |
                        //                   | PWR | NUM |     |---|     |     |     |
                        bindings = <
   &kp F1     &kp F2       &kp F3       &kp F4       &kp F5       &kp F6        &kp KP_N0  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MULTIPLY &kp KP_DIVIDE
   &kp F7     &kp F8       &kp F9       &kp F10      &kp F11      &kp F12       &kp KP_N0  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS    &kp KP_EQUAL
   &kp DEL    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4  &kp KP_N0  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_PLUS     &kp KP_DOT
                                  &ext_power EP_OFF  &kp KP_NLCK  &trans        &trans     &trans     &trans
                        >;
                };
        };
};
